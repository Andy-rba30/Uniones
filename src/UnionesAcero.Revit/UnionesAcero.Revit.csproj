<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adaptador para Autodesk Revit 2027.x (.NET 10).
    Las referencias a RevitAPI/RevitAPIUI vienen de los paquetes Nice3point (solo "ref",
    no se copian a la salida). Para compilar contra otra versión, cambia RevitVersion.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>UnionesAcero.Revit</RootNamespace>
    <AssemblyName>UnionesAcero.Revit</AssemblyName>
    <RevitVersion>2027</RevitVersion>
    <RevitApiPackageVersion>2027.2.0</RevitApiPackageVersion>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Revit carga el ensamblado desde su propio proceso; no generamos .exe ni host. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnionesAcero.Core\UnionesAcero.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="UnionesAcero.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Despliegue local en Windows: copia la DLL, el núcleo y el .addin a la carpeta de
    complementos del usuario para Revit 2027. Se ejecuta solo si existe %AppData%\Autodesk\Revit\Addins.
  -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' AND '$(DeployToRevit)' != 'false'">
    <PropertyGroup>
      <RevitAddinsRoot>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsRoot>
      <RevitAddinTarget>$(RevitAddinsRoot)\UnionesAcero</RevitAddinTarget>
    </PropertyGroup>
    <ItemGroup>
      <AddinBinaries Include="$(OutDir)UnionesAcero.Revit.dll;$(OutDir)UnionesAcero.Core.dll;$(OutDir)UnionesAcero.Revit.pdb;$(OutDir)UnionesAcero.Core.pdb" />
      <AddinConfig Include="config.json" Condition="!Exists('$(RevitAddinTarget)\config.json')" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinTarget)" Condition="Exists('$(RevitAddinsRoot)')" />
    <Copy SourceFiles="@(AddinBinaries)" DestinationFolder="$(RevitAddinTarget)" Condition="Exists('$(RevitAddinsRoot)')" ContinueOnError="true" />
    <Copy SourceFiles="@(AddinConfig)" DestinationFolder="$(RevitAddinTarget)" Condition="Exists('$(RevitAddinsRoot)')" ContinueOnError="true" />
    <Copy SourceFiles="UnionesAcero.addin" DestinationFolder="$(RevitAddinsRoot)" Condition="Exists('$(RevitAddinsRoot)')" ContinueOnError="true" />
    <Message Importance="high" Text="UnionesAcero desplegado en $(RevitAddinTarget)" Condition="Exists('$(RevitAddinsRoot)')" />
  </Target>

</Project>
